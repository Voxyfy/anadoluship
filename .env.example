# Apizone (sandbox.mngkargo.com.tr) üzerinde oluşturduğunuz uygulamanın
# kimlik bilgileri — bkz. README "MNG ile başlarken" bölümü.
MNG_CLIENT_ID=
MNG_CLIENT_SECRET=

# MNG test müşteri numarası ve şifresi — uygulama kimliğinden ayrı, hesap
# seviyesinde bir kimlik doğrulamadır.
MNG_CUSTOMER_NUMBER=
MNG_PASSWORD=

# developer.ups.com üzerinde oluşturduğunuz uygulamanın kimlik bilgileri ve
# ödeme yöntemi eklenmiş bir gönderici hesabına bağlı hesap numarası — bkz.
# README "UPS ile ilgili durum" bölümü.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=

# Yurtiçi Kargo web servis kimlik bilgileri — kurumsal başvuru sonrası
# bölge/pazarlama sorumlunuzdan alınır.
YURTICI_WS_USERNAME=
YURTICI_WS_PASSWORD=
# Hesabınıza bağlı sabit değerler (ShippingOrderVO'nun zorunlu alanları):
YURTICI_TAX_OFFICE_ID=
YURTICI_TT_DOCUMENT_ID=
YURTICI_DC_SELECTED_CREDIT=
YURTICI_DC_CREDIT_RULE=

# Aras Kargo web servis kimlik bilgileri — kurumsal başvuru sonrası alınır.
ARAS_USERNAME=
ARAS_PASSWORD=

# Sürat Kargo panel (ekargo.suratkargo.com.tr) kullanıcı adı/web servis şifresi.
SURAT_KULLANICI_ADI=
SURAT_SIFRE=

# PTT Kargo — kurumsal sözleşme sonrası verilen müşteri numarası/şifre/kullanıcı.
PTT_MUSTERI_ID=
PTT_SIFRE=
PTT_KULLANICI=
